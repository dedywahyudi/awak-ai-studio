# ---------- Public (exposed to the browser) ----------
# Canonical site URL, no trailing slash. Used for sitemap, canonical URLs, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number in international format without "+" or spaces, e.g. 6281234567890.
# Leave empty and every WhatsApp button falls back to the /kontak page.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public contact email shown in the footer and structured data.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: demo video (MP4/WebM URL). Empty = placeholder is shown.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# ---------- Supabase ----------
# Public project URL + anon key: used ONLY to read published blog posts (RLS enforced).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER prefix with NEXT_PUBLIC_. Used to insert leads.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
# Must be a verified sender/domain in Resend, e.g. "Awak AI Studio <leads@yourdomain.com>"
RESEND_FROM=
# Where new-lead notifications are sent (you).
LEAD_NOTIFY_EMAIL=

# ---------- Lead webhook (n8n -> WhatsApp / Slack / anything) ----------
# Optional. Each new lead is POSTed here as JSON. Easiest way to get a WhatsApp
# notification: n8n Webhook node -> WhatsApp node (Twilio / 360dialog / WA Cloud API).
LEAD_WEBHOOK_URL=
# Optional shared secret, sent as the "x-webhook-secret" header.
LEAD_WEBHOOK_SECRET=
