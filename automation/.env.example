# Copy to automation/.env on the VPS. Never commit .env.

# Domain pointing (A record) to the VPS, e.g. n8n.awak.example
N8N_HOST=

# --- The website ---
SITE_URL=https://awak.example
# Same value as AUTOMATION_SECRET in the website's environment.
AUTOMATION_SECRET=
# Same value as LEAD_WEBHOOK_SECRET in the website's environment.
LEAD_WEBHOOK_SECRET=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=

# --- Supabase (service role key: server side only, never in the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=Awak AI Studio <noreply@awak.example>
OWNER_EMAIL=

# --- WhatsApp Cloud API (only for workflow 04, and the optional owner alert in 01) ---
WA_TOKEN=
WA_PHONE_ID=
# Any random string; the same one you type into Meta's webhook setup.
WA_VERIFY_TOKEN=
# Your own number in international format, digits only (owner alerts, optional).
OWNER_WA=
